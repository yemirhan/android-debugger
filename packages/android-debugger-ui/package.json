{
  "name": "@yemirhan/android-debugger-ui",
  "version": "2.0.0",
  "description": "In-app debugger and UI components for React Native apps using Android Debugger",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --no-warnings --experimental-strip-types --test test/*.test.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@android-debugger/shared": "workspace:*",
    "@types/react": "^19.0.0",
    "@yemirhan/android-debugger-sdk": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@expo/vector-icons": ">=14.0.0",
    "@yemirhan/android-debugger-sdk": ">=2.0.0",
    "expo-router": ">=4.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.71.0"
  },
  "peerDependenciesMeta": {
    "@expo/vector-icons": {
      "optional": false
    },
    "@yemirhan/android-debugger-sdk": {
      "optional": false
    },
    "expo-router": {
      "optional": false
    },
    "react": {
      "optional": false
    },
    "react-native": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "react-native",
    "expo",
    "android",
    "ui-components",
    "debugging",
    "network-inspector",
    "devtools"
  ],
  "license": "MIT"
}
